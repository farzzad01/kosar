{
  "version": 2,
  "builds": [
    {
      "src": "nobatdehi/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb", 
        "runtime": "python3.9"
      }
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "nobatdehi/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "nobatdehi.settings"
  },
  "functions": {
    "nobatdehi/wsgi.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
